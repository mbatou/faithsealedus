# ---------------------------------------------------------------------------
# Supabase — create a project at https://supabase.com and copy these values
# from Project Settings → API.
# ---------------------------------------------------------------------------

# Public (browser-safe) values
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used by the /admin page to read every RSVP. NEVER expose this
# to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Name of the Storage bucket that holds the photo gallery images.
NEXT_PUBLIC_SUPABASE_GALLERY_BUCKET=gallery

# ---------------------------------------------------------------------------
# Admin
# ---------------------------------------------------------------------------

# Password that gates the /admin RSVP dashboard.
ADMIN_PASSWORD=change-me-to-something-strong
