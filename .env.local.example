# ---------------------------------------------------------------------------
# Database — Neon Postgres (https://neon.tech). On Vercel, add the Neon
# integration and it sets DATABASE_URL for you. Locally, copy the connection
# string from the Neon dashboard (use the pooled connection string).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# ---------------------------------------------------------------------------
# Admin — password that gates the /admin RSVP dashboard.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=change-me-to-something-strong

# ---------------------------------------------------------------------------
# Private ceremony — the code you share only with invited guests. Entering it
# unlocks the RSVP option for the exclusive evening on 5 December.
# ---------------------------------------------------------------------------
EXCLUSIVE_ACCESS_CODE=change-me-secret-code
