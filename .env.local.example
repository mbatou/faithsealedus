# ---------------------------------------------------------------------------
# Database — Neon Postgres (https://neon.tech). On Vercel, add the Neon
# integration and it sets DATABASE_URL for you. Locally, copy the connection
# string from the Neon dashboard (use the pooled connection string).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# ---------------------------------------------------------------------------
# Admin — password that gates the /admin RSVP dashboard.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=change-me-to-something-strong

# ---------------------------------------------------------------------------
# Private ceremony — the code you share only with invited guests. Entering it
# unlocks the RSVP option for the exclusive evening on 5 December.
# ---------------------------------------------------------------------------
EXCLUSIVE_ACCESS_CODE=change-me-secret-code

# ---------------------------------------------------------------------------
# Guest photo sharing — Vercel Blob. Create a Blob store in the Vercel
# dashboard (Storage → Create → Blob) and connect it to this project; Vercel
# then sets BLOB_READ_WRITE_TOKEN for you. Locally, copy it from the store.
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# ---------------------------------------------------------------------------
# Testing only — pretend "now" is another date, e.g. 2026-12-04T10:00:00Z to
# open Senegal uploads, or 2026-12-01T09:00:00Z to put the album on top of the
# home page. NEVER set this on Production; remove it after rehearsing.
# ---------------------------------------------------------------------------
# NOW_OVERRIDE=2026-12-04T10:00:00Z
